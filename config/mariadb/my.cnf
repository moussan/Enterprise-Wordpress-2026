###############################################################################
# Enterprise WordPress 2026 — MariaDB Configuration
# ============================================================================
# Optimized for WordPress workloads: read-heavy, UTF-8, InnoDB-focused.
# This file is mounted as /etc/mysql/conf.d/custom.cnf
###############################################################################

[mysqld]

# =============================================================================
# CHARACTER SET — Full Unicode support (emoji, international text)
# =============================================================================

# utf8mb4 supports full 4-byte Unicode (required for emoji in WordPress).
character-set-server = utf8mb4

# Modern Unicode collation (consistent sorting across languages).
collation-server = utf8mb4_unicode_ci

# =============================================================================
# INNODB — Primary storage engine tuning
# =============================================================================

# Buffer pool: main InnoDB cache for data and indexes.
# Rule of thumb: 50-80% of available container memory.
# For 2GB container limit: 1GB is optimal.
innodb_buffer_pool_size = 1G

# Number of buffer pool instances (reduces contention on multi-core).
# Use 1 instance per GB of buffer pool, minimum 1.
innodb_buffer_pool_instances = 1

# Log file size: larger = better write performance, longer crash recovery.
# 256MB is good for most WordPress installations.
innodb_log_file_size = 256M

# Log buffer size: writes are batched here before flushing to disk.
# 64MB handles bursts of writes (WooCommerce orders, bulk imports).
innodb_log_buffer_size = 64M

# Flush log at each commit (ACID compliance, safest setting).
# Set to 2 for better performance at risk of losing 1 second of data on crash.
innodb_flush_log_at_trx_commit = 1

# Use O_DIRECT to bypass OS file cache (InnoDB has its own cache).
# Prevents double-buffering and reduces memory pressure.
innodb_flush_method = O_DIRECT

# File per table: each table gets its own .ibd file.
# Easier to manage, reclaim space after table operations.
innodb_file_per_table = 1

# I/O capacity: IOPS the storage can handle.
# 200 = spinning disk, 2000+ = SSD, 10000+ = NVMe.
# Docker volumes on SSD: 2000 is a good starting point.
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000

# Read-ahead: prefetch pages for sequential scans.
innodb_read_ahead_threshold = 56

# Write doubling: protects against torn pages.
# Keep ON unless using filesystem with atomic writes (ZFS, ext4 with data=journal).
innodb_doublewrite = 1

# =============================================================================
# QUERY CACHE — Disabled (deprecated in MySQL 8, removed in MariaDB 11)
# =============================================================================
# WordPress uses Redis for object caching instead.
# Query cache causes lock contention under write-heavy workloads.

# =============================================================================
# CONNECTION MANAGEMENT
# =============================================================================

# Maximum simultaneous connections.
# Each PHP-FPM worker needs ~1 connection, plus WP-CLI, monitoring, etc.
max_connections = 100

# Threads cached for connection reuse (reduces thread creation overhead).
thread_cache_size = 16

# Wait timeout for idle connections (seconds).
# 300s matches PHP max_execution_time.
wait_timeout = 300

# Interactive connection timeout.
interactive_timeout = 300

# =============================================================================
# TABLE CACHE — Open table descriptors
# =============================================================================

# Number of open table descriptors cached.
# WordPress + plugins can use hundreds of tables.
table_open_cache = 2000

# Instances of table cache (reduces mutex contention).
table_open_cache_instances = 8

# Definition cache (stores .frm-like metadata).
table_definition_cache = 2000

# =============================================================================
# TEMPORARY TABLES & SORTING
# =============================================================================

# Maximum size for in-memory temporary tables.
# Larger = fewer disk-based temp tables = faster complex queries.
tmp_table_size = 64M

# Maximum heap table size (must match tmp_table_size).
max_heap_table_size = 64M

# Sort buffer for ORDER BY operations.
sort_buffer_size = 4M

# Join buffer for table joins without indexes.
join_buffer_size = 4M

# Read buffer for sequential scans.
read_buffer_size = 2M

# Read buffer for random reads (after sort).
read_rnd_buffer_size = 4M

# =============================================================================
# BINARY LOG — Point-in-time recovery capability
# =============================================================================

# Binary log format: ROW is safest for replication.
binlog_format = ROW

# Expire binary logs after 7 days (saves disk space).
expire_logs_days = 7

# Maximum binary log file size.
max_binlog_size = 100M

# Sync binary log to disk at each commit (safest).
sync_binlog = 1

# =============================================================================
# SLOW QUERY LOG — Performance monitoring
# =============================================================================

# Enable slow query logging (essential for finding bottlenecks).
slow_query_log = 1

# Log file location.
slow_query_log_file = /var/lib/mysql/slow-query.log

# Queries slower than 2 seconds are logged.
# Adjust based on your performance requirements.
long_query_time = 2

# Also log queries not using indexes (helps find missing indexes).
log_queries_not_using_indexes = 1

# Throttle: only log 100 no-index queries per minute (prevents log spam).
log_throttle_queries_not_using_indexes = 100

# =============================================================================
# NETWORKING
# =============================================================================

# Maximum allowed packet size (matches PHP upload_max_filesize).
max_allowed_packet = 128M

# Skip DNS resolution for connections (faster, use IP-based grants only).
skip-name-resolve = 1

# Only allow connections via TCP (Docker networking).
# Disable this if you need local socket connections.
skip-external-locking = 1

# =============================================================================
# SECURITY
# =============================================================================

# Prevent LOAD DATA LOCAL (prevents file read attacks).
local-infile = 0

# Symbolic links disabled (prevents symlink attacks).
symbolic-links = 0

[client]
# Client default character set.
default-character-set = utf8mb4

[mysql]
# MySQL CLI default character set.
default-character-set = utf8mb4
