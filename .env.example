###############################################################################
# Enterprise WordPress 2026 — Environment Configuration
# ============================================================================
# Copy this file to .env and customize ALL values before deployment.
#
# SECURITY: Never commit .env to version control. Only .env.example is tracked.
#
# Usage:
#   cp .env.example .env
#   nano .env                    # Edit all values
#   docker compose up -d         # Start with your configuration
###############################################################################

# =============================================================================
# PROJECT SETTINGS
# =============================================================================

# Docker Compose project name (prefixes all container and volume names).
COMPOSE_PROJECT_NAME=enterprise-wp

# Timezone for all services.
TIMEZONE=UTC

# =============================================================================
# DOMAIN & SSL
# =============================================================================

# Your domain name (used by Nginx and Certbot).
# For local development: leave as localhost
DOMAIN=example.com

# Email for Let's Encrypt certificate registration and expiry notifications.
CERTBOT_EMAIL=admin@example.com

# =============================================================================
# WORDPRESS SETTINGS
# =============================================================================

# WordPress table prefix (change for security — makes SQL injection harder).
# Use a random prefix like: wp_a8f3_
WP_TABLE_PREFIX=wp_

# WordPress site URL (include protocol).
WP_SITE_URL=https://example.com

# WordPress site title.
WP_SITE_TITLE=Enterprise WordPress

# WordPress admin credentials (change immediately after install!).
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
WP_ADMIN_EMAIL=admin@example.com

# Force SSL in admin panel (true for production, false for local dev).
WP_FORCE_SSL=true

# Disable file modifications in admin (true = locked down production).
WP_DISALLOW_FILE_MODS=false

# Enable debug mode (false for production, true for development).
WP_DEBUG=false
WP_DEBUG_LOG=false

# Disable WP-Cron (use system cron in production for reliability).
WP_DISABLE_CRON=false

# =============================================================================
# DATABASE — MariaDB
# =============================================================================

# Root password (used for database management, not by WordPress).
# Generate a strong password: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD_456!

# WordPress database name.
MYSQL_DATABASE=wordpress

# WordPress database user (not root — principle of least privilege).
MYSQL_USER=wordpress

# WordPress database password.
# Generate a strong password: openssl rand -base64 32
MYSQL_PASSWORD=CHANGE_THIS_DB_PASSWORD_789!

# =============================================================================
# PORTS — Service exposure
# =============================================================================

# Nginx HTTP port (80 for production, 8080 for local dev to avoid conflicts).
NGINX_HTTP_PORT=80

# Nginx HTTPS port (443 for production).
NGINX_HTTPS_PORT=443

# MariaDB port (only exposed in development via override).
MARIADB_PORT=3306

# Redis port (only exposed in development via override).
REDIS_PORT=6379

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# PHP-FPM max workers (adjust based on available memory).
# Each worker uses ~40-60MB. Formula: Available_RAM / 50MB
# PHP_FPM_MAX_CHILDREN=16

# MariaDB InnoDB buffer pool (50-80% of allocated DB memory).
# INNODB_BUFFER_POOL_SIZE=1G

# Redis max memory for object cache.
# REDIS_MAXMEMORY=256mb

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

# Backup retention (number of backups to keep).
BACKUP_RETENTION=7

# Backup directory (relative to project root).
BACKUP_DIR=./backups

# =============================================================================
# AWS S3 AUTOMATED BACKUPS (Optional)
# =============================================================================

# S3 bucket name (e.g. my-enterprise-wp-backups)
# AWS_S3_BUCKET=

# AWS Region
# AWS_DEFAULT_REGION=us-east-1

# AWS Credentials (leave blank if using EC2 IAM roles)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
